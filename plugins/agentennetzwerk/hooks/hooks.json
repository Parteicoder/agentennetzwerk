{
  "description": "Block Agentennetzwerk when required coding CLIs are missing.",
  "hooks": {
    "UserPromptExpansion": [
      {
        "matcher": "agentennetzwerk:start",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/check-dependencies.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}

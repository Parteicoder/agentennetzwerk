{
  "description": "Soft dependency reporting plus local factual token telemetry for Agentennetzwerk runs.",
  "hooks": {
    "UserPromptExpansion": [
      {
        "matcher": "agentennetzwerk:start",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/check-dependencies.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/telemetry-start.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "claude-builder|repo-explorer|architect|qa-reviewer|regression-hunter|security-reviewer|final-judge",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/telemetry-subagent.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/telemetry-stop.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}

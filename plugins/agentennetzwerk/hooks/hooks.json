{
  "description": "Warn once per Claude Code session when optional coding CLIs are missing, without blocking Agentennetzwerk.",
  "hooks": {
    "UserPromptExpansion": [
      {
        "matcher": "agentennetzwerk:start",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/check-dependencies.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
